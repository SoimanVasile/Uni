void UI::find_dupa_nume_si_producator(){
    std::string name, producator;

    std::cout<< "Nume: ";
    std::cin>>name;
    std::cout<< "Producator: ";
    std::cin>>producator;

    try {
        const auto& p = service_produs.find_dupa_nume_si_producator(name, producator);
        std::cout << "Produs gasit: " << p << "\n";
    } catch (const ValidatorException& e){
        std::cerr << "Validation error: "<< e.get_mesaj() << std::endl;
        return;
    }
    catch (const RepoException& e){
        std::cerr << "Repo Error: " << e.get_mesaj() << std::endl;
        return;
    }
}

void UI::filtrare_dupa_pret(){
    float pret = NAN;

    std::cout << "Pret: ";
    std::cin >> pret;

    auto lista = service_produs.filtrare_dupa_pret(pret);

    for (const auto& val : lista){
        std::cout<<val<<' ';
    }
    std::cout<<std::endl;
}

void UI::sortare_dupa_pret(){
    auto lista = service_produs.sortare_dupa_pret();

    for (const auto& val : lista){
        std::cout<<val<<' ';
    }
    std::cout<<std::endl;
}

void UI::filtrare_dupa_nume() {
    std::string nume;
    std::cout << "Nume: ";
    std::cin >> nume;

    auto lista = service_produs.filtrare_dupa_nume(nume);
    if (lista.empty()) std::cout << "Nu am gasit produse.\n";
    for (const auto& val : lista) std::cout << val << ' ';
    std::cout << "\n";
}

void UI::filtrare_dupa_producator() {
    std::string producator;
    std::cout << "Producator: ";
    std::cin >> producator;

    auto lista = service_produs.filtrare_dupa_producator(producator);
    if (lista.empty()) std::cout << "Nu am gasit produse.\n";
    for (const auto& val : lista) std::cout << val << ' ';
    std::cout << "\n";
}

void UI::sortare_dupa_nume() {
    auto lista = service_produs.sortare_dupa_nume();
    for (const auto& val : lista) std::cout << val << ' ';
    std::cout << "\n";
}

void UI::sortare_dupa_nume_si_tip() {
    auto lista = service_produs.sortare_dupa_nume_si_tip();
    for (const auto& val : lista) std::cout << val << ' ';
    std::cout << "\n";
}

void print_cos_total(const ServiceProdus& service_produs) {
    std::cout << "Suma totala a cosului momentan: " << service_produs.cos_total() << " lei.\n";
}

void UI::undo() {
    try {
        service_produs.undo();
        std::cout << "Undo realizat cu succes!\n";
    } catch (const ValidatorException& e) {
        std::cout << e.get_mesaj();
    }
}

void UI::cos_goleste() {
    service_produs.cos_goleste();
    std::cout << "Cosul a fost golit!\n";
    print_cos_total(service_produs);
}

void UI::cos_adauga() {
    std::string nume;
    std::cout << "Nume: ";
    std::cin >> nume;
    try {
        service_produs.cos_adauga(nume);
        std::cout << "Adaugat in cos!\n";
    } catch (const RepoException& e) {
        std::cout << "Repo Error: " << e.get_mesaj();
    }
    print_cos_total(service_produs);
}

void UI::cos_genereaza() {
    size_t n;
    std::cout << "Numar: ";
    std::cin >> n;
    service_produs.cos_genereaza(n);
    std::cout << "Cos vizitat (Random generat)!\n";
    print_cos_total(service_produs);
}

void UI::export_cos() {
    std::string tip, nume_fisier;
    std::cout << "Tip export (CSV/HTML): ";
    std::cin >> tip;
    std::cout << "Nume fisier: ";
    std::cin >> nume_fisier;

    try {
        if (tip == "CSV" || tip == "csv") {
            service_produs.cos_export_csv(nume_fisier);
            std::cout << "Exportat cu succes in CSV!\n";
        } else if (tip == "HTML" || tip == "html" || tip == "Html") {
            service_produs.cos_export_html(nume_fisier);
            std::cout << "Exportat cu succes in HTML!\n";
        } else {
            std::cout << "Tip invalid!\n";
        }
    } catch (const RepoException& e) {
        std::cout << e.get_mesaj();
    }
    print_cos_total(service_produs);
}


void UI::run() {
    int exit=0;
    while(!exit){
        int user_input = 0;
        menu();
        std::cout<<"Alege o optiune: ";
        std::cin>>user_input;
        switch (user_input) {
            case 0: {exit=1;break;}
            case 1: {UI::add_produs(); break;}
            case 2: {UI::print(); break;}
            case 3: {UI::sterge_produs(); break;}
            case 4: {UI::modifica_produs(); break;}
            case 5: {UI::find_dupa_nume_si_producator(); break;}
            case 6: {UI::filtrare_dupa_pret(); break;}
            case 7: {UI::sortare_dupa_pret(); break;}
            case 8: {UI::filtrare_dupa_nume(); break;}
            case 9: {UI::filtrare_dupa_producator(); break;}
            case 10: {UI::sortare_dupa_nume(); break;}
            case 11: {UI::sortare_dupa_nume_si_tip(); break;}
            case 12: {UI::undo(); break;}
            case 13: {UI::cos_goleste(); break;}
            case 14: {UI::cos_adauga(); break;}
            case 15: {UI::cos_genereaza(); break;}
            case 16: {UI::export_cos(); break;}
            default: {std::cout << "Optiune invalida!\n"; break;}
        }
    }
}
